# Authentication: JSON map from API key to roles. Replace every sample secret.
RAG_ENVIRONMENT=development
RAG_API_KEYS={"dev-secret-change-me":["employee","hr"]}

# Primary generation + embedding provider
RAG_GEMINI_API_KEY=
RAG_GEMINI_MODEL=gemini-3.6-flash
RAG_EMBEDDING_MODEL=gemini-embedding-001

# Optional fallback. The selected model must also be in the allowlist.
RAG_OPENROUTER_API_KEY=
RAG_OPENROUTER_MODEL=google/gemini-3.6-flash
RAG_OPENROUTER_ALLOWED_MODELS=["google/gemini-3.6-flash"]

# Qdrant
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_API_KEY=
RAG_QDRANT_COLLECTION=company_knowledge

# Safe by default: off | metadata-only | full
RAG_TRACE_MODE=metadata-only
RAG_ALLOW_SENSITIVE_TRACING=false
RAG_LANGFUSE_PUBLIC_KEY=
RAG_LANGFUSE_SECRET_KEY=
RAG_LANGFUSE_HOST=https://cloud.langfuse.com

# Upload and retrieval limits
RAG_MAX_UPLOAD_BYTES=20971520
RAG_RETRIEVAL_LIMIT=5
RAG_LEXICAL_CANDIDATE_LIMIT=500
RAG_ENABLE_ENRICHMENT=false
