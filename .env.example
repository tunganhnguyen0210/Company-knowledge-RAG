# Authentication: JSON map from API key to roles. Replace every sample secret.
ENVIRONMENT=development
API_KEYS={"dev-secret-change-me":["employee","hr"]}

# Select the primary generation provider: gemini | openrouter | openai.
# Other fully configured providers may handle transient failures as fallbacks.
MAIN_PROVIDER=gemini

# Gemini powers generation and is the embedding fallback when Jina is not configured.
# Add GEMINI_API_FALLBACK_KEY3, ...KEY4 and so on to widen the pool.
GEMINI_API_KEY=
GEMINI_API_FALLBACK_KEY=
GEMINI_API_FALLBACK_KEY2=
GEMINI_KEY_COOLDOWN_SECONDS=60
GEMINI_MODEL=gemini-3.6-flash

# Embeddings and Reranker
EMBEDDING_MODEL=jina-embeddings-v5-omni-small
EMBEDDING_DIMENSIONS=1024
JINA_API_KEY=
RERANKER_MODEL=jina-reranker-v3.5

# Used when MAIN_PROVIDER=openrouter or as an automatic fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash
OPENROUTER_ALLOWED_MODELS=["google/gemini-3.6-flash"]

# Used when MAIN_PROVIDER=openai or as an automatic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Qdrant. Point this at a cloud cluster (https://<id>.cloud.qdrant.io:6333) or run a
# local one with `docker compose --profile local-qdrant up -d qdrant`.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=company_knowledge

# Safe by default: off | metadata-only | full
TRACE_MODE=full
ALLOW_SENSITIVE_TRACING=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Upload and retrieval limits
MAX_UPLOAD_BYTES=20971520
RETRIEVAL_LIMIT=5
LEXICAL_CANDIDATE_LIMIT=500
# Query-level relevance gate: when no dense hit clears it, the query is treated as
# off-topic and only BM25 contributes. Calibrate per embedding model + corpus by
# comparing the top-1 score of on-topic and off-topic questions, then pick the middle.
MIN_DENSE_SCORE=0.50
ENABLE_ENRICHMENT=false
