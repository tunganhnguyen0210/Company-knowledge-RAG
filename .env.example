# Authentication: JSON map from API key to roles. Replace every sample secret.
ENVIRONMENT=development
API_KEYS={"dev-secret-change-me":["employee","hr"]}

# Select the primary generation provider: gemini | openrouter | openai.
# Other fully configured providers may handle transient failures as fallbacks.
MAIN_PROVIDER=gemini

# Gemini is always used for embeddings, whatever MAIN_PROVIDER is, so these keys are
# required. Multiple keys enable dynamic rotation & rate limit handling.
GEMINI_API_KEY=
GEMINI_API_FALLBACK_KEY=
GEMINI_API_FALLBACK_KEY2=
GEMINI_KEY_COOLDOWN_SECONDS=60
GEMINI_MODEL=gemini-3.6-flash

# Embeddings and Reranker
EMBEDDING_MODEL=jina-embeddings-v5-omni-small
EMBEDDING_DIMENSIONS=1024
JINA_API_KEY=
RERANKER_MODEL=jina-reranker-v3.5

# Used when MAIN_PROVIDER=openrouter or as an automatic fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash
OPENROUTER_ALLOWED_MODELS=["google/gemini-3.6-flash"]

# Used when MAIN_PROVIDER=openai or as an automatic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Offline Ragas judge; used only when rag-eval receives --ragas.
RAGAS_API_KEY=
RAGAS_BASE_URL=https://api.openai.com/v1
RAGAS_MODEL=gpt-4.1-mini
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_MAX_CONCURRENCY=2

# Qdrant (Qdrant Cloud)
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key
QDRANT_COLLECTION=company_knowledge

# Safe by default: off | metadata-only | full
TRACE_MODE=full
ALLOW_SENSITIVE_TRACING=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Upload and retrieval limits
MAX_UPLOAD_BYTES=20971520
RETRIEVAL_LIMIT=5
LEXICAL_CANDIDATE_LIMIT=500
MIN_DENSE_SCORE=0.35
ENABLE_ENRICHMENT=false

# Level 1 - Chunking strategy upgrades (default off: legacy fixed-window chunking)
CHUNK_SEMANTIC_ENABLED=false
CHUNK_SEMANTIC_THRESHOLD=0.85
RAPTOR_ENABLED=false
RAPTOR_CLUSTER_SIZE=5
RAPTOR_MAX_DEPTH=1

# Level 1 - Enrichment upgrades (default off)
ENRICH_MRL_ENABLED=false
ENRICH_MRL_DIMENSIONS=128

# Hierarchical retrieval - pull in a retrieved chunk's siblings so the legal
# section reads whole. Expansion is all-or-nothing per section: a family that
# does not fit the budget is skipped entirely (a partial family would splice
# non-adjacent text together). Default off.
HIERARCHICAL_EXPANSION_ENABLED=false
HIERARCHICAL_MAX_PARENTS=3
HIERARCHICAL_CHAR_BUDGET=8000
HIERARCHICAL_MAX_PARENT_CHARS=8000
HIERARCHICAL_MIN_POOL_COVERAGE=0.0
